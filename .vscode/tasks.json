{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "process",
            "command": "cargo",
            "args": ["build", "--locked"],
            "problemMatcher": "$rustc",
            "group": { "kind": "build", "isDefault": true }
        },
        {
            "label": "test",
            "type": "process",
            "command": "cargo",
            "args": ["test", "--locked"],
            "problemMatcher": "$rustc",
            "group": "test"
        },
        {
            "label": "release",
            "type": "process",
            "command": "cargo",
            "args": ["build", "--release", "--locked"],
            "problemMatcher": "$rustc"
        }
    ]
}
